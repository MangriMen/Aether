{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PluginFailure",
  "description": "A failure a plugin reports to the host with more than text.\n\nTo report it, a plugin sets the error of its call (`error_set`) to the marker\n`aether-plugin-failure:` directly followed by this value as one line of JSON, and returns a\nnon-zero code. The host looks for the marker anywhere in the string, so a prefix added by a\nplugin framework does no harm, and ignores whatever follows the JSON. A string with no valid\nenvelope is an ordinary failure with that text as its cause.",
  "type": "object",
  "properties": {
    "host": {
      "description": "The error a host function returned to the plugin, passed back untouched. Absent when the\nfailure is the plugin's own. A value the host does not understand is ignored, the\n`message` still counts.",
      "anyOf": [
        {
          "$ref": "#/$defs/HostError"
        },
        {
          "type": "null"
        }
      ]
    },
    "message": {
      "description": "What the plugin says went wrong; shown as the cause when `host` is absent or not understood.",
      "type": "string"
    }
  },
  "required": [
    "message"
  ],
  "$defs": {
    "CommandRefusalDto": {
      "description": "Why a command was not run.",
      "oneOf": [
        {
          "description": "The user said no, or said it earlier and the plugin has not been reloaded since.",
          "type": "string",
          "const": "denied"
        },
        {
          "description": "Nobody answered in time.",
          "type": "string",
          "const": "timedOut"
        },
        {
          "description": "The plugin was stopped or removed.",
          "type": "string",
          "const": "cancelled"
        },
        {
          "description": "The jar changed while the user was being asked.",
          "type": "string",
          "const": "jarChanged"
        },
        {
          "description": "A value this version of the API does not know: a newer launcher sent it. Read it, never\nwrite it.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "HostError": {
      "description": "Why a host function failed. The kind tells a plugin what it can do about it; `message` is\ntext for the log or the user, not something to match on.",
      "oneOf": [
        {
          "description": "What the plugin sent is refused: an invalid id, path, version or page, a value the host\ndoes not know or does not support. Sending it again fails again.",
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "message"
              ]
            },
            "type": {
              "type": "string",
              "const": "invalidArgument"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "description": "What the plugin named does not exist: an instance, a plugin, an importer, a provider.",
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "message"
              ]
            },
            "type": {
              "type": "string",
              "const": "notFound"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "description": "The plugin may not do this: a path outside what it was given, a program it is not\nallowed. A host an HTTP function refuses is `http` with `hostNotAllowed` instead.",
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "message"
              ]
            },
            "type": {
              "type": "string",
              "const": "accessDenied"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "description": "The user did not allow the plugin's command, or was not there to.",
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                },
                "reason": {
                  "$ref": "#/$defs/CommandRefusalDto"
                }
              },
              "required": [
                "reason",
                "message"
              ]
            },
            "type": {
              "type": "string",
              "const": "commandNotApproved"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "description": "A file the plugin asked to read is larger than the host accepts (an over-long network\nanswer is `http` / `responseTooLarge`).",
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "message"
              ]
            },
            "type": {
              "type": "string",
              "const": "tooLarge"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "description": "The state does not allow it now: the instance is running or still installing, a plugin\nis loading or busy. It may succeed later.",
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "message"
              ]
            },
            "type": {
              "type": "string",
              "const": "conflict"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "description": "The work was called off before it finished.",
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "message"
              ]
            },
            "type": {
              "type": "string",
              "const": "cancelled"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "description": "The work did not finish in the time it was given.",
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "message"
              ]
            },
            "type": {
              "type": "string",
              "const": "timedOut"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "description": "A call into a plugin failed: the other plugin crashed, hit a limit or reported an error.",
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "message"
              ]
            },
            "type": {
              "type": "string",
              "const": "pluginCallFailed"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "description": "A network request failed; `error` tells how.",
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "error": {
                  "$ref": "#/$defs/HttpErrorDto"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "message",
                "error"
              ]
            },
            "type": {
              "type": "string",
              "const": "http"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "description": "The host failed on its own: storage, the file system, anything the plugin can do nothing\nabout.",
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "message"
              ]
            },
            "type": {
              "type": "string",
              "const": "internal"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "description": "A kind this version of the API does not know: a newer launcher sent it. Read it, never\nwrite it.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "unknown"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "HttpErrorDto": {
      "description": "How a network request failed: the `error` of the `http` kind of `HostError`. A plugin matches\non the kind; a `reason` is text for the log or the user, like the `message`.",
      "oneOf": [
        {
          "description": "The host is not in the plugin's `allowedHosts`: the URL asked for, or a redirect to it.\nThe user can allow it in the plugin's settings.",
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "host": {
                  "type": "string"
                }
              },
              "required": [
                "host"
              ]
            },
            "type": {
              "type": "string",
              "const": "hostNotAllowed"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "description": "The host resolves to an address a plugin may not reach (loopback, private, link-local,\n…), or to none at all.",
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "host": {
                  "type": "string"
                }
              },
              "required": [
                "host"
              ]
            },
            "type": {
              "type": "string",
              "const": "addressBlocked"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "description": "The request itself is refused before anything is sent: the URL, its scheme or host, a\nheader, the JSON body or its size, the expected hash of a download. Sending it again fails\nagain.",
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "reason"
              ]
            },
            "type": {
              "type": "string",
              "const": "invalidRequest"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "description": "A redirect that is not followed: to `http` from `https`, without a usable `Location`, more\nthan the limit, or any 3xx where none is followed (`http_post_json`, `304`, …).",
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "reason"
              ]
            },
            "type": {
              "type": "string",
              "const": "redirect"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "description": "The answer is larger than the host accepts, in bytes.",
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "limit": {
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0
                }
              },
              "required": [
                "limit"
              ]
            },
            "type": {
              "type": "string",
              "const": "responseTooLarge"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "description": "The final answer has an error status. `http_get` and `http_post_json` hand a status back\nas an answer instead; a download, and the launcher's own requests for a plugin, fail with it.",
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "integer",
                  "format": "uint16",
                  "maximum": 65535,
                  "minimum": 0
                }
              },
              "required": [
                "status"
              ]
            },
            "type": {
              "type": "string",
              "const": "status"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "description": "The downloaded file is not the one the hash names.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "hashMismatch"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "The answer could not be read as what was expected: not the JSON, TOML or text the launcher\nasked for, or a URL in it that cannot be used.",
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "reason"
              ]
            },
            "type": {
              "type": "string",
              "const": "invalidResponse"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "description": "No usable answer came back: the host could not be resolved or reached, the connection or\nTLS failed, the request timed out or broke off. It may succeed later.",
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "reason"
              ]
            },
            "type": {
              "type": "string",
              "const": "network"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "description": "A kind this version of the API does not know: a newer launcher sent it. Read it, never\nwrite it.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "unknown"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    }
  }
}