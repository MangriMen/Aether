{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "lint:types": {
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "tsconfig.json"],
    },
    "lint:code": {
      "inputs": ["src/**/*.{ts,tsx,js,jsx}", ".oxlintrc.json"],
    },
    "lint:eslint": {
      "inputs": ["src/**/*.{ts,tsx,js,jsx}", "eslint.config*"],
      "outputs": ["node_modules/.cache/eslint/**"],
    },
    "lint:format": {
      "inputs": ["src/**/*.{ts,tsx,js,jsx,css}", ".oxfmtrc.json"],
    },
    "lint:arch": {
      "inputs": ["src/**/*", ".dependency-cruiser.cjs"],
    },
    "lint:all": {
      "dependsOn": [
        "lint:types",
        "lint:code",
        "lint:eslint",
        "lint:format",
        "lint:arch",
      ],
    },
  },
}
