{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // Inputs list everything the task reads, otherwise turbo reports a false cache hit
    // after a config or dependency change.
    "lint:types": {
      "inputs": [
        "src/**",
        ".storybook/**",
        "scripts/**",
        "*.ts",
        "tsconfig*.json",
        "package.json",
      ],
    },
    "lint:code": {
      "inputs": ["src/**", "package.json", ".oxlintrc.json"],
    },
    "lint:eslint": {
      "inputs": ["src/**", "scripts/**", "*.ts", "eslint.config.js", "package.json"],
      "outputs": ["node_modules/.cache/eslint/**"],
    },
    "lint:format": {
      "inputs": ["src/**", ".storybook/**", "scripts/**", "*.{ts,js,mjs,cjs}", ".oxfmtrc.json", "package.json"],
    },
    "lint:arch": {
      "inputs": ["src/**", "scripts/**", ".dependency-cruiser.cjs", "tsconfig*.json", "package.json"],
    },
    "lint:unused": {
      "inputs": ["src/**", ".storybook/**", "scripts/**", "*.ts", "knip.jsonc", "tsconfig*.json", "package.json"],
    },
    "lint:all": {
      "dependsOn": [
        "lint:types",
        "lint:code",
        "lint:eslint",
        "lint:format",
        "lint:arch",
        "lint:unused",
      ],
    },
  },
}
