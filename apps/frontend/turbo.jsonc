{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "lint:types": {
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "tsconfig.json"],
    },
    "lint:code": {
      "inputs": ["src/**/*.{ts,tsx,js,jsx}", "eslint.config*", ".prettierrc*"],
      "outputs": ["node_modules/.cache/eslint/**"],
    },
    "lint:arch": {
      "inputs": ["src/**/*", "steiger.config.*"],
    },
    "lint:all": {
      "dependsOn": ["lint:types", "lint:code", "lint:arch"],
    },
  },
}
