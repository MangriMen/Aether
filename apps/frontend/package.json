{
  "name": "@aether/frontend",
  "version": "0.10.5",
  "description": "",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "arch:graph": "depcruise src --config .dependency-cruiser.cjs --include-only \"^src\" --collapse \"^src/(app/pages/[^/]+|(app|platform|features|shared)/[^/]+)\" -T mermaid -f arch-graph.mmd",
    "build": "vite build",
    "bump": "bumpp",
    "clean": "bun x rimraf .turbo",
    "dev": "vite",
    "format": "oxfmt \"src/**/*.{ts,tsx,js,jsx,css}\" \"*.{ts,js,mjs,cjs}\" \".storybook/**/*.{ts,tsx}\" \"scripts/**/*.ts\"",
    "format:check": "oxfmt --check \"src/**/*.{ts,tsx,js,jsx,css}\" \"*.{ts,js,mjs,cjs}\" \".storybook/**/*.{ts,tsx}\" \"scripts/**/*.ts\"",
    "lint": "bun lint:types && bun lint:code && bun lint:eslint && bun lint:format && bun lint:arch",
    "lint:arch": "depcruise src --config .dependency-cruiser.cjs && bun scripts/check-module-cycles.ts",
    "lint:code": "oxlint --max-warnings 0",
    "lint:code:fix": "oxlint --fix",
    "lint:eslint": "eslint . --cache --cache-location node_modules/.cache/eslint/.eslintcache --max-warnings 0",
    "lint:eslint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/.eslintcache",
    "lint:format": "bun run format:check",
    "lint:types": "tsgo --project tsconfig.json --noEmit && tsgo --project tsconfig.node.json --noEmit",
    "lint:unused": "knip",
    "serve": "vite preview",
    "start": "vite",
    "tauri": "tauri",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@formisch/solid": "^1.1.0",
    "@kobalte/core": "0.13.12",
    "@solid-primitives/i18n": "^2.2.1",
    "@solid-primitives/media": "^2.3.6",
    "@solid-primitives/resize-observer": "^2.2.0",
    "@solid-primitives/scheduled": "^1.5.3",
    "@solid-primitives/storage": "4.3.5",
    "@solidjs/router": "^1.0.0",
    "@tanstack/solid-query": "^5.104.4",
    "@tanstack/solid-table": "^9.3.1",
    "@tanstack/solid-virtual": "^3.13.48",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-os": "^2.4.0",
    "caniuse-lite": "^1.0.30001815",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "semver": "^7.8.5",
    "solid-js": "^1.9.17",
    "solid-transition-group": "^0.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "valibot": "^1.5.0",
    "vite-plugin-solid-svg": "^0.8.1"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-themes": "^10.6.2",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "24.19.2",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitest/ui": "^5.0.5",
    "baseline-browser-mapping": "^2.11.29",
    "bumpp": "^12.3.0",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.13.0",
    "eslint-plugin-better-tailwindcss": "^4.9.1",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-solid": "^0.18.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "execa": "^10.2.0",
    "jsdom": "^30.1.2",
    "knip": "^6.42.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "storybook": "^10.6.2",
    "storybook-solidjs-vite": "^10.7.2",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.4",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.5"
  }
}
