{
  "name": "@aether/monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-only",
  "workspaces": {
    "packages": [
      "apps/*"
    ],
    "catalogs": {
      "build": {
        "@tauri-apps/cli": "^2.12.2"
      }
    }
  },
  "scripts": {
    "aether:bump": "bun --filter @aether/frontend run bump",
    "build": "turbo run build --continue",
    "clean": "turbo run clean && bun x rimraf .turbo && cargo clean",
    "db:setup": "bun run scripts/db-setup.mjs",
    "licenses:generate": "node scripts/licenses/generate-third-party-licenses.mjs",
    "desktop:build": "turbo run build --filter=@aether/desktop",
    "desktop:dev": "turbo run dev --filter=@aether/desktop",
    "frontend:build": "turbo run build --filter=@aether/frontend",
    "frontend:dev": "turbo run dev --filter=@aether/frontend",
    "lint": "turbo run lint:all lint:rust --continue",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "lefthook": "^2.2.2",
    "turbo": "^2.11.8",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=24"
  }
}
